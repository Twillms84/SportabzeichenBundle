{% extends '@IServCore/page.html.twig' %}

{% block title %}Mein Sportabzeichen {{ year }}{% endblock %}

{% block content %}

{# --- GENAUE MAPPING VORGABE --- #}
{% set unitMap = {
    'UNIT_METERS': 'm', 
    'UNIT_CENTIMETERS': 'cm', 
    'UNIT_SECONDS': 'Sek.', 
    'UNIT_MINUTES': 'Min.', 
    'UNIT_HOURS': 'Std.', 
    'UNIT_NUMBER': 'Anz.', 
    'UNIT_PIECES': 'Wert', 
    'NONE': 'Verband', 
    'UNIT_NONE': 'Verband'
} %}

{# --- WELCHE EINHEITEN SIND ZEIT? (Doppelpunkt statt Komma) --- #}
{% set time_units = ['UNIT_SECONDS', 'UNIT_MINUTES', 'UNIT_HOURS'] %}

{% set cat_icons = {
    'Ausdauer': 'fa-heartbeat',
    'Kraft': 'fa-dumbbell',
    'Schnelligkeit': 'fa-running',
    'Koordination': 'fa-balance-scale'
} %}

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1">Mein Sportabzeichen {{ year }}</h1>
            <p class="text-muted mb-0">Übersicht deiner Leistungen und Ziele</p>
        </div>
    </div>

    {# Flash Messages #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} shadow-sm">{{ message }}</div>
        {% endfor %}
    {% endfor %}

    {% for catName, disciplines in categories %}
        {% if disciplines is not empty %}
        
        {% set colorClass = cycle(['primary', 'success', 'warning', 'info'], loop.index0) %}
        
        <div class="card shadow-sm mb-4 border-left-{{ colorClass }}">
            <div class="card-header bg-white py-3 d-flex align-items-center">
                <i class="fa {{ cat_icons[catName]|default('fa-list') }} text-{{ colorClass }} me-2"></i>
                <h5 class="m-0 font-weight-bold text-dark">{{ catName }}</h5>
            </div>
            
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="bg-light text-muted small text-uppercase">
                        <tr>
                            <th style="width: 30%;" class="ps-4">Disziplin</th>
                            <th style="width: 10%;" class="text-center text-bronze">Bronze</th>
                            <th style="width: 10%;" class="text-center text-secondary">Silber</th>
                            <th style="width: 10%;" class="text-center text-warning">Gold</th>
                            <th style="width: 40%;" class="ps-4">Mein Training</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in disciplines %}
                            {% set einheit_label = unitMap[row.einheit]|default(row.einheit) %}
                            {% set is_time = row.einheit in time_units %}
                            
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold">{{ row.name }}</div>
                                    <span class="badge bg-light text-muted border">{{ einheit_label }}</span>
                                </td>
                                
                                {# --- FORMATIERUNGSLOGIK --- #}
                                {% if is_time %}
                                    {# Zeit: Doppelpunkt (z.B. 12.30 -> 12:30) #}
                                    <td class="text-center small font-monospace">{{ row.bronze|number_format(2, '.', '')|replace({'.': ':'}) }}</td>
                                    <td class="text-center small font-monospace">{{ row.silber|number_format(2, '.', '')|replace({'.': ':'}) }}</td>
                                    <td class="text-center small font-monospace">{{ row.gold|number_format(2, '.', '')|replace({'.': ':'}) }}</td>
                                {% else %}
                                    {# Strecke: Komma (z.B. 12.50 -> 12,5) #}
                                    <td class="text-center small font-monospace">{{ row.bronze|number_format(2, ',', '.')|trim('0', 'right')|trim(',') }}</td>
                                    <td class="text-center small font-monospace">{{ row.silber|number_format(2, ',', '.')|trim('0', 'right')|trim(',') }}</td>
                                    <td class="text-center small font-monospace">{{ row.gold|number_format(2, ',', '.')|trim('0', 'right')|trim(',') }}</td>
                                {% endif %}

                                <td class="ps-4">
                                    <a href="{{ path('pulsr_sportabzeichen_training_detail', { disciplineId: row.discipline_id }) }}" 
                                       class="btn btn-outline-primary btn-sm w-100 d-flex justify-content-between align-items-center group-hover">
                                        
                                        <span>
                                            {% if row.training_value is not empty %}
                                                {# User Input formatieren #}
                                                {% if row.training_value matches '/^\\d+(\\.\\d+)?$/' %}
                                                    {% if is_time %}
                                                        {# User hat z.B. 12.30 eingegeben -> Anzeige 12:30 #}
                                                        <span class="fw-bold">{{ row.training_value|replace({'.': ':'}) }}</span>
                                                    {% else %}
                                                        <span class="fw-bold">{{ row.training_value|number_format(2, ',', '.')|trim('0', 'right')|trim(',') }}</span>
                                                    {% endif %}
                                                {% else %}
                                                     <span class="fw-bold">{{ row.training_value }}</span>
                                                {% endif %}
                                                <small>{{ einheit_label }}</small>
                                            {% else %}
                                                <span class="small text-muted fst-italic">Eintragen...</span>
                                            {% endif %}
                                        </span>

                                        <i class="fa fa-chevron-right small text-muted"></i>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
        {% endif %}
    {% endfor %}
</div>

<style>
    .text-bronze { color: #cd7f32; font-weight: bold; }
    .border-left-primary { border-left: 4px solid #0d6efd; }
    .border-left-success { border-left: 4px solid #198754; }
    .border-left-warning { border-left: 4px solid #ffc107; }
    .border-left-info { border-left: 4px solid #0dcaf0; }
    .group-hover:hover .fa-chevron-right { transform: translateX(3px); transition: transform 0.2s; }
</style>
{% endblock %}