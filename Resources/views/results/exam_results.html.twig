{% extends '@IServCore/page.html.twig' %}

{# --- TITEL --- #}
{% block title %}Ergebnisse – {{ exam.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/sportabzeichen_results.css', 'pulsr-sportabzeichen') }}">
    
    {# WICHTIG: Das hier sorgt dafür, dass die Spalten wirklich ausgeblendet werden #}
    <style>
        .col-hidden {
            display: none !important;
        }
        /* Optional: Leichter Fade-Effekt für Spalten */
        .col-discipline {
            transition: opacity 0.2s ease;
        }
    </style>
{% endblock %}

{% block content %}

{# --- KONFIGURATION & HELPER --- #}
{% set unitMap = {
    'UNIT_METERS': 'm',
    'UNIT_CENTIMETERS': 'cm',
    'UNIT_SECONDS': 'Sek.',
    'UNIT_MINUTES': 'Min.',
    'UNIT_HOURS': 'Std.',
    'UNIT_NUMBER': 'Anz.'
} %}

<div class="container-fluid mt-3">
    
    {# --- HEADER (Responsive) --- #}
    <div class="row g-2 align-items-center mb-3">
        
        {# 1. TITEL (Nimmt auf Handy volle Breite ein, auf Desktop nur so viel wie nötig) #}
        <div class="col-12 col-md-auto">
            <h4 class="mb-0">🏅 {{ exam.name }} <small class="text-muted">({{ exam.year }})</small></h4>
        </div>

        {# 2. FILTER (Nimmt auf Desktop den restlichen Platz, auf Handy neue Zeile) #}
        <div class="col-12 col-md">
            <div class="view-selector-wrapper">
                <select id="viewSelector" class="form-control select2" multiple="multiple" data-placeholder="{{ 'Ansicht wählen...'|trans }}">
                    {% for category in disciplines|keys %}
                        {% if category|upper not in ['SWIMMING', 'SCHWIMMEN'] %}
                            <option value="{{ category }}" selected>{{ category }}</option>
                        {% endif %}
                    {% endfor %}
                </select>
            </div>
        </div>

        {# 3. BUTTONS (Auf Handy rechtsbündig oder volle Breite, je nach Geschmack) #}
        <div class="col-12 col-md-auto d-flex gap-2 justify-content-between justify-content-md-end">
            
            {# Button Text auf Handy verstecken (optional), um Platz zu sparen? 
               Hier lasse ich den Text drin, aber mache die Buttons klein (btn-sm) #}
            
            <a href="{{ path('sportabzeichen_results_print_groupcard', {'examId': exam.id, 'class': app.request.query.get('class')}) }}" 
               class="btn btn-default btn-sm flex-fill flex-md-grow-0" target="_blank">
                {{ icon('print')|raw }} <span class="d-inline d-md-inline">{{ 'Drucken'|trans }}</span>
            </a>
            
            <a href="{{ path('sportabzeichen_exams_dashboard') }}" 
               class="btn btn-outline-secondary btn-sm flex-fill flex-md-grow-0">
                {{ icon('arrow-left')|raw }} {{ 'Zurück'|trans }}
            </a>
        </div>
    </div>

    {# --- FORMULAR & TABELLE --- #}
    <form id="autosave-form" 
      data-discipline-route="{{ path('sportabzeichen_results_exam_discipline_save') }}"
      data-result-route="{{ path('sportabzeichen_results_exam_result_save') }}"
      data-swimming-route="{{ path('sportabzeichen_results_exam_swimming_add_proof') }}"
      data-swimming-delete-route="{{ path('sportabzeichen_results_exam_swimming_remove_proof') }}"
      data-global-token="{{ csrf_token('authenticate') }}">

        <div class="table-responsive">
            <table class="table table-sm table-bordered table-results-compact align-middle table-hover">
                <thead class="table-light text-center align-middle sticky-top" style="z-index: 10;">
                    <tr>
                        {# SPALTE: TEILNEHMER (Sortierbar) #}
                        <th class="col-name text-start" style="min-width: 200px;">
                            {% set currentSort = app.request.query.get('sort', 'lastname') %}
                            {% set currentOrder = app.request.query.get('order', 'asc') %}
                            
                            {% if currentSort == 'lastname' and currentOrder == 'asc' %}
                                {% set nextOrder = 'desc' %}
                                {% set sortIcon = icon('arrow-down') %}
                            {% elseif currentSort == 'lastname' and currentOrder == 'desc' %}
                                {% set nextOrder = 'asc' %}
                                {% set sortIcon = icon('arrow-up') %}
                            {% else %}
                                {% set nextOrder = 'asc' %}
                                {% set sortIcon = '' %}
                            {% endif %}

                            <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({
                                'id': exam.id, 
                                'sort': 'lastname', 
                                'order': nextOrder
                            })) }}" 
                            class="sort-header d-flex justify-content-between align-items-center text-dark text-decoration-none">
                                <span>Teilnehmer</span>
                                <span>{{ sortIcon|raw }}</span>
                            </a>
                        </th>

                        {# SPALTEN: DISZIPLINEN KÖPFE #}
                        {% for category in disciplines|keys %}
                            {% if category|upper not in ['SWIMMING', 'SCHWIMMEN'] %}
                                {# WICHTIG: col-cat-{{ category }} für JS Toggle #}
                                <th class="col-discipline col-cat-{{ category }}">{{ category }}</th>
                            {% endif %}
                        {% endfor %}
                    </tr>
                </thead>
                <tbody>
                {% for p in participants %}
                    {% set epResults = results[p.ep_id] ?? {} %}
                    <tr data-ep-id="{{ p.ep_id }}" id="row-{{ p.ep_id }}">
                        
                        {# 1. TEILNEHMER INFOS #}
                        <td class="col-name py-2">
                            <div class="name-container">
                                <span class="name-main fw-bold">{{ p.vorname }} {{ p.nachname }}</span>
                                <span class="name-age text-muted">({{ p.age_year }})</span>
                            </div>
                            
                            <div class="small text-muted mb-2">
                                Klasse: <span class="text-dark fw-semibold">{{ p.klasse|default('-') }}</span>
                            </div>
                            
                            <div class="d-flex flex-column gap-1">
                                {# Punkte & Medaille #}
                                <div class="d-flex gap-2 align-items-center mt-1 mb-2">
        
                                    {# Punkte Badge #}
                                    <div class="result-badge-box border rounded px-2 py-1 text-center bg-light" title="Gesamtpunkte">
                                        <div class="small text-uppercase text-muted" style="font-size: 0.65rem;">Punkte</div>
                                        <div class="fw-bold fs-6" id="total-points-{{ p.ep_id }}">{{ p.total_points|default(0) }}</div>
                                    </div>

                                    {# Medaille Badge #}
                                    {% set medalValue = p.final_medal|default('none')|lower %}
                                    {% set medalLabel = '-' %}
                                    {% set medalClass = 'bg-light text-muted border' %}

                                    {% if medalValue == 'gold' %}
                                        {% set medalLabel = 'Gold' %}
                                        {% set medalClass = 'bg-gold text-dark border-gold' %}
                                    {% elseif medalValue == 'silver' or medalValue == 'silber' %}
                                        {% set medalLabel = 'Silber' %}
                                        {% set medalClass = 'bg-silver text-dark border-silver' %}
                                    {% elseif medalValue == 'bronze' %}
                                        {% set medalLabel = 'Bronze' %}
                                        {% set medalClass = 'bg-bronze text-white border-bronze' %}
                                    {% endif %}

                                    <div class="result-badge-box rounded px-2 py-1 text-center js-medal-badge {{ medalClass }}" 
                                         id="final-medal-{{ p.ep_id }}"
                                         style="min-width: 70px;">
                                        <div class="small text-uppercase opacity-75" style="font-size: 0.65rem;">Medaille</div>
                                        <div class="fw-bold fs-6 medal-label">{{ medalLabel }}</div>
                                    </div>
                                </div>

                                {# Schwimmen Bereich #}
                                <div id="swimming-wrapper-{{ p.ep_id }}" class="swimming-wrapper">
                                    <div class="swim-badge-container {% if not p.has_swimming %}d-none{% endif %}">
                                        <span class="badge badge-success js-swim-info">
                                            {{ p.swimming_met_via ? p.swimming_met_via : 'Erledigt' }}
                                        </span>
                                    </div>

                                    {# Dropdown für Schwimmen #}
                                    <div class="swim-dropdown-container {% if p.has_swimming %}d-none{% endif %}">
                                        <select class="form-control form-control-sm swimming-select-compact" 
                                                data-ep-id="{{ p.ep_id }}"
                                                data-type="swimming_select" 
                                                data-save="true">
                                            <option value="">Schwimmen wählen...</option>
                                            {% for swimDisc in swimming_disciplines %}
                                                <option value="{{ swimDisc.id }}">{{ swimDisc.name }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    {# Delete Button #}
                                    <button type="button" 
                                            class="btn-delete-swimming js-delete-swimming"
                                            data-ep-id="{{ p.ep_id }}"
                                            title="Zurücksetzen">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                            </div>
                        </td>

                        {# 2. DISZIPLINEN (Loop über Kategorien) #}
                        {% for category, items in disciplines %}
                            {% if category|upper not in ['SWIMMING', 'SCHWIMMEN'] %}
                                
                                {# WICHTIG: col-cat-{{ category }} muss auch hier sein #}
                                <td class="p-1 col-discipline col-cat-{{ category }}">
                                    
                                    {# --- LOGIK START: Optionen sammeln --- #}
                                    {% set options = [] %}
                                    {% set pGender = p.geschlecht %} 
                                    
                                    {% for discipline in items %}
                                        {% if discipline.requirements is defined %}
                                            {% for req in discipline.requirements %}
                                                {% if req.gender == pGender and p.age_year >= req.minAge and p.age_year <= req.maxAge %}
                                                    {% set combo = req|merge({'discipline': discipline}) %}
                                                    {% set options = options|merge([combo]) %}
                                                {% endif %}
                                            {% endfor %}
                                        {% endif %}
                                    {% endfor %}

                                    {# --- LOGIK: Aktuelles Ergebnis finden --- #}
                                    {% set selectedReq = null %}
                                    {% set resObj = null %}

                                    {% for req in options %}
                                        {% if epResults[req.discipline.id] is defined %}
                                            {% set selectedReq = req %}
                                            {% set resObj = epResults[req.discipline.id] %}
                                        {% endif %}
                                    {% endfor %}

                                    {# Fallback: Erste Option #}
                                    {% if selectedReq is null and options|length > 0 %}
                                        {% set selectedReq = options[0] %}
                                    {% endif %}
                                    
                                    {# CSS Klasse für Input Farbe #}
                                    {% set mClass = 'medal-none' %}
                                    {% if resObj %}
                                        {% if resObj.points == 3 %}{% set mClass = 'medal-gold' %}
                                        {% elseif resObj.points == 2 %}{% set mClass = 'medal-silber' %}
                                        {% elseif resObj.points == 1 %}{% set mClass = 'medal-bronze' %}
                                        {% endif %}
                                    {% endif %}
                                    {# --- LOGIK ENDE --- #}

                                    <div class="d-flex flex-column">
                                        
                                        {# SELECT BOX #}
                                        <select class="discipline-selector js-discipline-select mb-1 {{ mClass }}" 
                                                data-save 
                                                data-ep-id="{{ p.ep_id }}" 
                                                data-type="discipline" 
                                                data-kategorie="{{ category }}">
                                            
                                            {% if options is empty %}
                                                <option value="">--</option>
                                            {% else %}
                                                {% for req in options %}
                                                    {% set cleanUnit = unitMap[req.discipline.unit] ?? req.discipline.unit %}
                                                    
                                                    <option value="{{ req.discipline.id }}" 
                                                            {{ selectedReq.discipline.id == req.discipline.id ? 'selected' : '' }}
                                                            data-unit="{{ cleanUnit }}"
                                                            data-calc="{{ req.discipline.calculation_type|default('') }}"
                                                            data-bronze="{{ req.bronze }}"
                                                            data-silber="{{ req.silver }}"
                                                            data-gold="{{ req.gold }}">
                                                        {{ req.discipline.name }}
                                                    </option>
                                                {% endfor %}
                                            {% endif %}
                                        </select>

                                        {# INPUT FELD & EINHEIT #}
                                        <div class="input-group input-group-sm">
                                            <input type="text" 
                                                   class="form-control form-control-custom {{ mClass }}"
                                                   value="{{ resObj ? resObj.leistung : '' }}"
                                                   data-save 
                                                   data-ep-id="{{ p.ep_id }}" 
                                                   data-type="leistung" 
                                                   data-kategorie="{{ category }}">

                                            {# WICHTIG: Klassen 'js-unit-label' und 'input-group-text-unit' für JS hinzugefügt #}
                                            <span class="input-group-text px-1 text-muted js-unit-label input-group-text-unit" style="font-size: 0.7rem;">
                                                {% set currentUnit = unitMap[selectedReq.discipline.unit] ?? '' %}
                                                {{ currentUnit }}
                                            </span>
                                        </div>

                                        {# HINTS (Bronze/Silber/Gold) #}
                                        <div class="req-hint">
                                            <span class="req-val-b" title="Bronze">B:<span class="js-val-b">{{ selectedReq ? selectedReq.bronze : '-' }}</span></span>
                                            <span class="req-val-s" title="Silber">S:<span class="js-val-s">{{ selectedReq ? selectedReq.silver : '-' }}</span></span>
                                            <span class="req-val-g" title="Gold">G:<span class="js-val-g">{{ selectedReq ? selectedReq.gold : '-' }}</span></span>
                                        </div>
                                    </div>
                                </td>
                            {% endif %}
                        {% endfor %}
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </form>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/exam_results_autosave.js', 'pulsr-sportabzeichen') }}"></script>
{% endblock %}