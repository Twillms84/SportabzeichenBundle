{# ... dein Header Code ... #}

{% for discipline, genders in topList %}
    <div class="card mb-4">
        <div class="card-header">
            <h3>{{ discipline }}</h3>
        </div>
        <div class="card-body">
            <div class="row">
                {# MÄNNLICH #}
                {% if genders['Männlich'] is defined and genders['Männlich'] is not empty %}
                <div class="col-md-6">
                    <h4 class="text-primary">Männlich</h4>
                    
                    {% for ak, results in genders['Männlich'] %}
                        <h5 class="mt-3 text-secondary">{{ ak }}</h5>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Platz</th>
                                    <th>Name</th>
                                    <th>Klasse</th>
                                    <th class="text-end">Leistung</th>
                                    <th class="text-end">Punkte</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in results %}
                                    <tr>
                                        <td>{{ loop.index }}.</td>
                                        <td>{{ row.firstname }} {{ row.lastname }}</td>
                                        <td>{{ row.group_name }}</td>
                                        <td class="text-end">{{ row.value }}</td>
                                        <td class="text-end"><strong>{{ row.points }}</strong></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endfor %}
                </div>
                {% endif %}

                {# WEIBLICH #}
                {% if genders['Weiblich'] is defined and genders['Weiblich'] is not empty %}
                <div class="col-md-6">
                    <h4 class="text-danger">Weiblich</h4> {% for ak, results in genders['Weiblich'] %}
                        <h5 class="mt-3 text-secondary">{{ ak }}</h5>
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Platz</th>
                                    <th>Name</th>
                                    <th>Klasse</th>
                                    <th class="text-end">Leistung</th>
                                    <th class="text-end">Punkte</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for row in results %}
                                    <tr>
                                        <td>{{ loop.index }}.</td>
                                        <td>{{ row.firstname }} {{ row.lastname }}</td>
                                        <td>{{ row.group_name }}</td>
                                        <td class="text-end">{{ row.value }}</td>
                                        <td class="text-end"><strong>{{ row.points }}</strong></td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endfor %}