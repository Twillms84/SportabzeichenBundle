{% extends "@IServCore/page.html.twig" %}

{% block page_title %}{{ 'Teilnehmer hinzufügen'|trans }}{% endblock %}

{# WICHTIG: Hier muss 'page_content' stehen, nicht 'body'! #}
{% block page_content %}
    
    <div class="content">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2>{{ 'Teilnehmer manuell hinzufügen'|trans }}</h2>
            <a href="{{ path('sportabzeichen_exams_dashboard') }}" class="btn btn-secondary">
                {{ icon('arrow-left') }} {{ 'Zurück'|trans }}
            </a>
        </div>

        <div class="card">
            <div class="card-header">
                Prüfung: <strong>{{ exam.exam_name|default('Unbenannt') }} ({{ exam.exam_year }})</strong>
            </div>
            
            <div class="card-body">
                <form method="post">
                    
                    {# 1. IServ Account Name #}
                    <div class="mb-3">
                        <label class="form-label" for="account">{{ 'IServ-Account'|trans }}</label>
                        <div class="input-group">
                            <span class="input-group-text">{{ icon('user') }}</span>
                            {# data-autocomplete-url sorgt für die Namensvorschläge #}
                            <input type="text" 
                                   name="account" 
                                   id="account" 
                                   class="form-control" 
                                   placeholder="z.B. vorname.nachname" 
                                   required 
                                   autocomplete="off">
                        </div>
                        <div class="form-text">{{ 'Gib den Accountnamen des Schülers ein.'|trans }}</div>
                    </div>

                    <div class="row">
                        {# 2. Geschlecht #}
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="gender">{{ 'Geschlecht'|trans }}</label>
                            <select name="gender" id="gender" class="form-select" required>
                                <option value="" disabled selected>{{ 'Bitte wählen...'|trans }}</option>
                                <option value="MALE">{{ 'Männlich'|trans }}</option>
                                <option value="FEMALE">{{ 'Weiblich'|trans }}</option>
                            </select>
                        </div>

                        {# 3. Geburtsdatum #}
                        <div class="col-md-6 mb-3">
                            <label class="form-label" for="dob">{{ 'Geburtsdatum'|trans }}</label>
                            <input type="date" name="dob" id="dob" class="form-control" required>
                        </div>
                    </div>

                    <div class="mt-3 text-end">
                        <button type="submit" class="btn btn-success">
                            {{ icon('plus') }} {{ 'Hinzufügen'|trans }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

{% endblock %}