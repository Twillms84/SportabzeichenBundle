{% extends "@IServCore/page.html.twig" %}

{% block page_title %}{{ 'Teilnehmer manuell hinzufügen'|trans }} - {{ exam.exam_name }}{% endblock %}

{% block page_content %}
    {# --- Header & Zurück --- #}
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a href="{{ path('sportabzeichen_exams_dashboard') }}" class="btn btn-secondary">
            {{ icon('arrow-left') }} {{ 'Zurück zur Übersicht'|trans }}
        </a>
    </div>

    <div class="alert alert-info">
        {{ icon('info-circle') }} {{ 'Hier werden alle Benutzer angezeigt, die noch nicht Teil dieser Prüfung sind. Benutzer ohne hinterlegtes Geburtsdatum erscheinen oben.'|trans }}
    </div>

    {# --- Suchleiste --- #}
    <div class="card mb-4">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-auto flex-grow-1">
                    <div class="input-group">
                        <span class="input-group-text">{{ icon('search') }}</span>
                        <input type="text" name="q" class="form-control" 
                               placeholder="{{ 'Suchen nach Name, Account oder Klasse...'|trans }}" 
                               value="{{ search_term }}">
                    </div>
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">{{ 'Suchen'|trans }}</button>
                    {% if search_term %}
                        <a href="{{ path('sportabzeichen_exams_add_participant', {'id': exam.id}) }}" class="btn btn-outline-secondary" title="{{ 'Filter zurücksetzen'|trans }}">
                            {{ icon('remove') }}
                        </a>
                    {% endif %}
                </div>
            </form>
        </div>
    </div>

    {# --- Ergebnis-Tabelle --- #}
    <div class="card">
        <div class="card-header">
            {{ 'Verfügbare Benutzer'|trans }} 
            <span class="badge bg-secondary ms-2">{{ missing_students|length }}{% if missing_students|length >= 500 %}+{% endif %}</span>
        </div>
        
        {% if missing_students is empty %}
            <div class="card-body text-center text-muted py-5">
                {{ icon('prohibition') }} {{ 'Keine weiteren Benutzer gefunden.'|trans }}
            </div>
        {% else %}
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>{{ 'Name'|trans }}</th>
                            <th>{{ 'Klasse'|trans }}</th>
                            <th>{{ 'Account'|trans }}</th>
                            <th style="width: 170px;">{{ 'Geburtsdatum'|trans }}</th>
                            <th style="width: 90px;">{{ 'Geschlecht'|trans }}</th>
                            <th style="width: 60px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for student in missing_students %}
                            {% set formId = 'add_user_' ~ student.account %}
                            
                            {# Zeilen-Hintergrund leicht rötlich, wenn Daten fehlen #}
                            <tr {% if not student.dob %}class="table-warning"{% endif %}>
                                <td>
                                    <strong>{{ student.name }}</strong>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">{{ student.class }}</span>
                                </td>
                                <td>
                                    <span class="font-monospace small text-muted">{{ student.account }}</span>
                                </td>
                                <td>
                                    {# Wenn Datum fehlt: Roter Rand am Input #}
                                    {% if student.dob %}
                                        {{ student.dob|date('d.m.Y') }}
                                        <input type="hidden" name="dob" value="{{ student.dob }}" form="{{ formId }}">
                                    {% else %}
                                        <input type="date" name="dob" required 
                                               class="form-control form-control-sm border-danger" 
                                               title="{{ 'Geburtsdatum fehlt!'|trans }}"
                                               form="{{ formId }}">
                                    {% endif %}
                                </td>
                                <td>
                                    <select name="gender" class="form-select form-select-sm" form="{{ formId }}">
                                        <option value="MALE" {% if student.gender == 'MALE' %}selected{% endif %}>M</option>
                                        <option value="FEMALE" {% if student.gender == 'FEMALE' %}selected{% endif %}>W</option>
                                        <option value="DIVERSE" {% if student.gender == 'DIVERSE' %}selected{% endif %}>D</option>
                                    </select>
                                </td>
                                <td class="text-end">
                                    <form method="post" id="{{ formId }}">
                                        <input type="hidden" name="account" value="{{ student.account }}">
                                        <button type="submit" class="btn btn-sm btn-success" title="{{ 'Hinzufügen'|trans }}">
                                            {{ icon('plus') }}
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% if missing_students|length >= 500 %}
                <div class="card-footer text-muted text-center small">
                    {{ 'Anzeige auf 500 Einträge begrenzt. Bitte Suchfunktion nutzen.'|trans }}
                </div>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}