{% extends "@IServCore/page.html.twig" %}

{% block page_title %}{{ 'Teilnehmer hinzufügen'|trans }} - {{ exam.exam_name }}{% endblock %}

{% block page_content %}
    <a href="{{ path('sportabzeichen_exams_show', {'id': exam.id}) }}" class="btn btn-secondary mb-3">
        {{ icon('arrow-left') }} {{ 'Zurück zur Prüfung'|trans }}
    </a>

    <div class="card mb-4">
        <div class="card-header">{{ 'Klasse auswählen'|trans }}</div>
        <div class="card-body">
            <form method="get" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label for="filter_class" class="col-form-label">{{ 'Klasse:'|trans }}</label>
                </div>
                <div class="col-auto">
                    <select name="filter_class" id="filter_class" class="form-select" onchange="this.form.submit()">
                        <option value="">-- {{ 'Bitte wählen'|trans }} --</option>
                        {% for class in classes %}
                            <option value="{{ class }}" {% if selected_class == class %}selected{% endif %}>{{ class }}</option>
                        {% endfor %}
                    </select>
                </div>
            </form>
        </div>
    </div>

    {% if selected_class %}
        <div class="card">
            <div class="card-header bg-light">
                {{ 'Noch nicht erfasste Schüler in Klasse'|trans }} <strong>{{ selected_class }}</strong>
            </div>
            
            {% if missing_students is empty %}
                <div class="card-body text-center text-success">
                    {{ icon('ok') }} {{ 'Alle Schüler dieser Klasse sind bereits in dieser Prüfung!'|trans }}
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Account</th>
                                <th style="width: 160px;">Geburtsdatum</th>
                                <th style="width: 100px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for student in missing_students %}
                                <tr>
                                    {# Pro Zeile ein Formular #}
                                    <form method="post">
                                        <td>
                                            <strong>{{ student.name }}</strong>
                                            <input type="hidden" name="account" value="{{ student.account }}">
                                            <input type="hidden" name="gender" value="{{ student.gender }}">
                                        </td>
                                        <td><span class="badge bg-secondary">{{ student.account }}</span></td>
                                        <td>
                                            {% if student.dob %}
                                                {# Datum bekannt -> Anzeigen #}
                                                {{ student.dob|date('d.m.Y') }}
                                                <input type="hidden" name="dob" value="{{ student.dob }}">
                                            {% else %}
                                                {# Datum unbekannt -> Eingabe #}
                                                <input type="date" name="dob" required class="form-control form-control-sm">
                                            {% endif %}
                                        </td>
                                        <td class="text-end">
                                            <button type="submit" class="btn btn-sm btn-success" title="Hinzufügen">
                                                {{ icon('plus') }} {{ 'Add'|trans }}
                                            </button>
                                        </td>
                                    </form>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}