{% extends "@IServCore/page.html.twig" %}

{% block page_title %}{{ 'Teilnehmer hinzufügen'|trans }} - {{ exam.exam_name }}{% endblock %}

{% block page_content %}
    {# --- Zurück Button --- #}
    <a href="{{ path('sportabzeichen_exams_dashboard') }}" class="btn btn-secondary mb-3">
        {{ icon('arrow-left') }} {{ 'Zurück zur Übersicht'|trans }}
    </a>

    {# --- Auswahl-Bereich --- #}
    <div class="card mb-4">
        <div class="card-header">{{ 'Quelle auswählen'|trans }}</div>
        <div class="card-body">
            
            {# --- Tabs --- #}
            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <a class="nav-link {% if mode == 'class' %}active{% endif %}" 
                       href="{{ path('sportabzeichen_exams_add_participant', {'id': exam.id, 'mode': 'class'}) }}">
                        {{ icon('list') }} {{ 'Nach Klasse'|trans }}
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link {% if mode == 'group' %}active{% endif %}" 
                       href="{{ path('sportabzeichen_exams_add_participant', {'id': exam.id, 'mode': 'group'}) }}">
                        {{ icon('group') }} {{ 'Nach Gruppe'|trans }}
                    </a>
                </li>
            </ul>

            {# --- Filter Formular --- #}
            <form method="get" class="row g-3 align-items-center">
                <input type="hidden" name="mode" value="{{ mode }}">

                <div class="col-auto">
                    <label for="filter_value" class="col-form-label fw-bold">
                        {% if mode == 'group' %}
                            {{ 'Gruppe wählen:'|trans }}
                        {% else %}
                            {{ 'Klasse wählen:'|trans }}
                        {% endif %}
                    </label>
                </div>
                
                <div class="col-auto">
                    <select name="filter_value" id="filter_value" class="form-select" onchange="this.form.submit()">
                        <option value="">-- {{ 'Bitte wählen'|trans }} --</option>
                        {% if mode == 'group' %}
                            {% for group in groups %}
                                <option value="{{ group.act }}" {% if filter_value == group.act %}selected{% endif %}>
                                    {{ group.name }} ({{ group.act }})
                                </option>
                            {% endfor %}
                        {% else %}
                            {% for class in classes %}
                                <option value="{{ class }}" {% if filter_value == class %}selected{% endif %}>
                                    {{ class }}
                                </option>
                            {% endfor %}
                        {% endif %}
                    </select>
                </div>

                <div class="col-auto">
                    <button type="submit" class="btn btn-primary">
                        {{ icon('search') }} {{ 'Anzeigen'|trans }}
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# --- Ergebnis-Liste --- #}
    {% if filter_value %}
        <div class="card">
            <div class="card-header bg-light">
                {{ 'Verfügbare Benutzer aus'|trans }} <strong>{{ filter_value }}</strong>
            </div>
            
            {% if missing_students is empty %}
                <div class="card-body text-center text-success py-4">
                    <div class="fs-4 mb-2">{{ icon('ok') }}</div>
                    <div>{{ 'Alle Personen dieser Liste sind bereits in dieser Prüfung!'|trans }}</div>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>{{ 'Name'|trans }}</th>
                                <th>{{ 'Account'|trans }}</th>
                                <th style="width: 180px;">{{ 'Geburtsdatum'|trans }}</th>
                                <th style="width: 100px;">{{ 'Geschlecht'|trans }}</th>
                                <th style="width: 80px;" class="text-end">{{ 'Aktion'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for student in missing_students %}
                                {# Eindeutige ID für das Formular dieser Zeile #}
                                {% set formId = 'form_user_' ~ student.account %}
                                
                                <tr>
                                    <td>
                                        <strong>{{ student.name }}</strong>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">{{ student.account }}</span>
                                    </td>
                                    <td>
                                        {# Geburtsdatum Input #}
                                        {% if student.dob %}
                                            {# Wenn Datum vorhanden, nur anzeigen und Hidden Field nutzen #}
                                            {{ student.dob|date('d.m.Y') }}
                                            <input type="hidden" name="dob" value="{{ student.dob }}" form="{{ formId }}">
                                        {% else %}
                                            {# Wenn kein Datum, Input anzeigen. WICHTIG: form-Attribut verknüpft es mit dem Formular #}
                                            <input type="date" name="dob" required class="form-control form-control-sm" form="{{ formId }}">
                                        {% endif %}
                                    </td>
                                    <td>
                                        {# Geschlecht Select #}
                                        <select name="gender" class="form-select form-select-sm" form="{{ formId }}">
                                            <option value="MALE" {% if student.gender == 'MALE' %}selected{% endif %}>M</option>
                                            <option value="FEMALE" {% if student.gender == 'FEMALE' %}selected{% endif %}>W</option>
                                            <option value="DIVERSE" {% if student.gender == 'DIVERSE' %}selected{% endif %}>D</option>
                                        </select>
                                    </td>
                                    <td class="text-end">
                                        {# Das eigentliche Formular sitzt hier valid in der Zelle #}
                                        <form method="post" id="{{ formId }}">
                                            <input type="hidden" name="account" value="{{ student.account }}">
                                            
                                            <button type="submit" class="btn btn-sm btn-success" title="{{ 'Hinzufügen'|trans }}">
                                                {{ icon('plus') }}
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}