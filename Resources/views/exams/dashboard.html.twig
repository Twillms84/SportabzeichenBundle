{% extends '@IServCore/page.html.twig' %}

{% block title %}Sportabzeichen Übersicht{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {# Wir laden nur dein CSS, kein JS mehr nötig #}
    <link rel="stylesheet" href="{{ asset('pulsrsportabzeichen/css/dashboard.css') }}">
    <style>
        .btn .icon { margin-right: 4px; }
        .btn-toolbar { display: flex; gap: 5px; }
        
        /* Farben für den Medaillenspiegel */
        .bg-gold { background-color: #FFD700 !important; color: #554400; }
        .bg-silver { background-color: #C0C0C0 !important; color: #333; }
        .bg-bronze { background-color: #CD7F32 !important; color: #fff; }
        .bg-none { background-color: #f5f5f5 !important; color: #777; box-shadow: inset 0 1px 2px rgba(0,0,0,.1); }
    </style>
{% endblock %}

{% block content %}
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h1 class="h3 m-0">Sportabzeichen Dashboard</h1>
            <a href="{{ path('sportabzeichen_exams_new') }}" class="btn btn-primary">
                <span class="icon icon-plus"></span> Neue Prüfung anlegen
            </a>
        </div>
    </div>

    {% if yearlyStats is empty %}
        <div class="alert alert-info">
            Noch keine Prüfungen angelegt. Starten Sie mit "Neue Prüfung anlegen".
        </div>
    {% else %}

        {# KEIN DATA-STORE MEHR NÖTIG #}

        {% for year, data in yearlyStats %}
            <div class="panel panel-default mb-4">
                <div class="panel-heading d-flex justify-content-between align-items-center" style="background-color: #f8f9fa;">
                    <h3 class="panel-title font-weight-bold" style="font-size: 1.25rem;">
                        <span class="icon icon-calendar"></span> Jahrgang {{ year }}
                    </h3>
                    <span class="badge">{{ data.exams|length }} Termine</span>
                </div>
                
                <div class="panel-body">
                    <div class="row">
                        {# --- LINKS: LISTE --- #}
                        <div class="col-md-8">
                            <h5 class="text-muted text-uppercase font-weight-bold mb-3">Prüfungstermine</h5>
                            <div class="list-group">
                                {% for exam in data.exams %}
                                    <div class="list-group-item clearfix" style="display: flex; justify-content: space-between; align-items: center;">
                                        
                                        {# Name und Datum #}
                                        <div>
                                            <h4 class="list-group-item-heading mt-0 mb-1">
                                                <a href="{{ path('sportabzeichen_results_index', {id: exam.id}) }}" class="text-primary font-weight-bold">
                                                    {{ exam.exam_name }}
                                                </a>
                                            </h4>
                                            <p class="list-group-item-text text-muted small">
                                                <span class="icon icon-calendar"></span> 
                                                {{ exam.exam_date ? exam.exam_date|date('d.m.Y') : 'Kein Datum' }}
                                            </p>
                                        </div>

                                        {# Buttons #}
                                        <div class="btn-toolbar" style="margin-left: auto;">
                                            <a href="{{ path('sportabzeichen_results_index', {id: exam.id}) }}" class="btn btn-sm btn-primary" title="Ergebnisse">
                                                <span class="icon icon-pencil"></span> Ergebnisse
                                            </a>
                                            <a href="{{ path('sportabzeichen_exams_stats', {id: exam.id}) }}" class="btn btn-sm btn-default" title="Statistik">
                                                <span class="icon icon-chart-bar"></span> Statistik
                                            </a>
                                            <a href="{{ path('sportabzeichen_exams_edit', {id: exam.id}) }}" class="btn btn-sm btn-default" title="Bearbeiten">
                                                <span class="icon icon-cog"></span> Ändern
                                            </a>
                                            <button type="button" class="btn btn-sm btn-danger" 
                                                    onclick="if(confirm('Wirklich löschen?')) { document.getElementById('del-{{ exam.id }}').submit(); }">
                                                <span class="icon icon-trash"></span> Löschen
                                            </button>
                                            <form id="del-{{ exam.id }}" action="{{ path('sportabzeichen_exams_delete', {id: exam.id}) }}" method="post" style="display:none;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ exam.id) }}">
                                            </form>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        {# --- RECHTS: STATISTIK BALKEN (Ersetzt Chart) --- #}
                        <div class="col-md-4 border-left">
                            <h5 class="text-center text-muted mb-4">Medaillenspiegel {{ year }}</h5>
                            
                            {% set total_participants = data.unique_users|length %}
                            
                            {% if total_participants > 0 %}
                                {% set p_gold = (data.stats.Gold / total_participants * 100) %}
                                {% set p_silver = (data.stats.Silber / total_participants * 100) %}
                                {% set p_bronze = (data.stats.Bronze / total_participants * 100) %}
                                {# Rest berechnen für Teilnehmer ohne Medaille #}
                                {% set count_none = total_participants - data.stats.Total %}
                                {% set p_none = (count_none / total_participants * 100) %}

                                {# 1. Der visuelle Balken #}
                                <div class="progress" style="height: 30px; border: 1px solid #ddd;">
                                    {% if data.stats.Gold > 0 %}
                                        <div class="progress-bar bg-gold" style="width: {{ p_gold }}%" title="Gold: {{ data.stats.Gold }}">
                                            {{ data.stats.Gold }}
                                        </div>
                                    {% endif %}
                                    {% if data.stats.Silber > 0 %}
                                        <div class="progress-bar bg-silver" style="width: {{ p_silver }}%" title="Silber: {{ data.stats.Silber }}">
                                            {{ data.stats.Silber }}
                                        </div>
                                    {% endif %}
                                    {% if data.stats.Bronze > 0 %}
                                        <div class="progress-bar bg-bronze" style="width: {{ p_bronze }}%" title="Bronze: {{ data.stats.Bronze }}">
                                            {{ data.stats.Bronze }}
                                        </div>
                                    {% endif %}
                                    {% if count_none > 0 %}
                                        <div class="progress-bar bg-none" style="width: {{ p_none }}%" title="Ohne Medaille: {{ count_none }}">
                                            <span style="color:#999">{{ count_none }}</span>
                                        </div>
                                    {% endif %}
                                </div>

                                {# 2. Legende #}
                                <div class="mt-3 small">
                                    <ul class="list-unstyled">
                                        <li><span class="badge bg-gold">&nbsp;</span> Gold: <strong>{{ data.stats.Gold }}</strong></li>
                                        <li><span class="badge bg-silver">&nbsp;</span> Silber: <strong>{{ data.stats.Silber }}</strong></li>
                                        <li><span class="badge bg-bronze">&nbsp;</span> Bronze: <strong>{{ data.stats.Bronze }}</strong></li>
                                        <li><span class="badge bg-none" style="border: 1px solid #ccc">&nbsp;</span> Ohne: <strong>{{ count_none }}</strong></li>
                                        <li class="mt-2 border-top pt-2">
                                            <strong>Gesamt: {{ total_participants }} Teilnehmer</strong>
                                        </li>
                                    </ul>
                                </div>

                                <div class="text-center mt-3 text-success font-weight-bold">
                                    Erfolgsquote: {{ ((data.stats.Total / total_participants) * 100)|round(1) }}%
                                </div>

                            {% else %}
                                <div class="alert alert-warning text-center">
                                    Noch keine Teilnehmerdaten.
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}

    {% endif %}
{% endblock %}