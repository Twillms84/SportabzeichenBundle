{% extends '@IServCore/page.html.twig' %}

{% block title %}Sportabzeichen Übersicht{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .chart-wrapper {
            position: relative; 
            height: 220px; 
            width: 100%;
        }
        .stat-card {
            transition: all 0.2s;
            border-left: 4px solid transparent;
        }
        .stat-card:hover { transform: translateY(-2px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; }
        
        .border-gold { border-left-color: #FFD700 !important; }
        .border-silver { border-left-color: #A9A9A9 !important; }
        .border-bronze { border-left-color: #cd7f32 !important; }
        .text-gold { color: #FFD700; }
        .text-silver { color: #A9A9A9; }
        .text-bronze { color: #cd7f32; }
    </style>
{% endblock %}

{% block content %}
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h1 class="h3 m-0">Sportabzeichen Dashboard</h1>
            {% if is_granted('PRIV_SPORTABZEICHEN_ADMIN') %}
                <a href="{{ path('sportabzeichen_exams_new') }}" class="btn btn-primary">
                    <span class="icon icon-plus"></span> Neue Prüfung
                </a>
            {% endif %}
        </div>
    </div>

    {% if yearlyStats is empty %}
        <div class="alert alert-info">
            Noch keine Prüfungen angelegt. Starten Sie mit "Neue Prüfung".
        </div>
    {% else %}

        {% for year, data in yearlyStats %}
            <div class="panel panel-default mb-4">
                <div class="panel-heading d-flex justify-content-between align-items-center" style="background-color: #f8f9fa;">
                    <h3 class="panel-title font-weight-bold" style="font-size: 1.25rem;">
                        <span class="icon icon-calendar"></span> Jahrgang {{ year }}
                    </h3>
                    <span class="badge">{{ data.exams|length }} Termine</span>
                </div>
                
                <div class="panel-body">
                    <div class="row">
                        {# --- LINKS: STATISTIK & LISTE --- #}
                        <div class="col-md-8">
                            
                            {# Info Cards #}
                            <div class="row mb-4">
                                <div class="col-sm-6 col-lg-3">
                                    <div class="card shadow-sm p-3 mb-2 bg-white rounded text-center border-gold stat-card">
                                        <div class="h3 m-0 font-weight-bold text-gold">{{ data.stats.Gold }}</div>
                                        <small class="text-muted text-uppercase">Gold</small>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-3">
                                    <div class="card shadow-sm p-3 mb-2 bg-white rounded text-center border-silver stat-card">
                                        <div class="h3 m-0 font-weight-bold text-silver">{{ data.stats.Silber }}</div>
                                        <small class="text-muted text-uppercase">Silber</small>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-3">
                                    <div class="card shadow-sm p-3 mb-2 bg-white rounded text-center border-bronze stat-card">
                                        <div class="h3 m-0 font-weight-bold text-bronze">{{ data.stats.Bronze }}</div>
                                        <small class="text-muted text-uppercase">Bronze</small>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-3">
                                    <div class="card shadow-sm p-3 mb-2 bg-white rounded text-center stat-card" style="border-left: 4px solid #0d6efd;">
                                        <div class="h3 m-0 font-weight-bold text-primary">{{ data.unique_users|length }}</div>
                                        <small class="text-muted text-uppercase">Teilnehmer</small>
                                    </div>
                                </div>
                            </div>

                            <hr>

                            {# Liste der Prüfungen #}
                            <h5 class="text-muted text-uppercase font-weight-bold mb-3" style="font-size: 0.85rem;">Prüfungstermine</h5>
                            <div class="list-group">
                                {% for exam in data.exams %}
                                    <a href="{{ path('sportabzeichen_exams_stats', {id: exam.id}) }}" class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <h5 class="list-group-item-heading mb-1 font-weight-bold">
                                                {{ exam.exam_name }}
                                            </h5>
                                            <p class="list-group-item-text text-muted mb-0">
                                                <span class="icon icon-calendar"></span> {{ exam.exam_date ? exam.exam_date|date('d.m.Y') : 'Kein Datum' }}
                                            </p>
                                        </div>
                                        <div>
                                            {# Buttons für Aktionen #}
                                            <span class="btn btn-sm btn-default" title="Zur Auswertung">
                                                <span class="icon icon-chart-bar"></span> Auswertung
                                            </span>
                                            {% if is_granted('PRIV_SPORTABZEICHEN_ADMIN') %}
                                                <a href="{{ path('sportabzeichen_exams_edit', {id: exam.id}) }}" class="btn btn-sm btn-default ml-2" title="Bearbeiten">
                                                    <span class="icon icon-pencil"></span>
                                                </a>
                                            {% endif %}
                                        </div>
                                    </a>
                                {% endfor %}
                            </div>
                        </div>

                        {# --- RECHTS: CHART --- #}
                        <div class="col-md-4 border-left">
                            <h5 class="text-center text-muted mb-3">Medaillenspiegel {{ year }}</h5>
                            <div class="chart-wrapper">
                                <canvas id="chart-{{ year }}"></canvas>
                            </div>
                            <div class="text-center mt-3 small text-muted">
                                Erfolgsquote: 
                                {% if data.unique_users|length > 0 %}
                                    {{ ((data.stats.Total / data.unique_users|length) * 100)|round(1) }}%
                                {% else %}
                                    0%
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}

    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Chart.js via CDN laden. Falls IServ das blockt, muss es lokal in Assets liegen #}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const yearlyData = {{ yearlyStats|json_encode|raw }};

            Object.keys(yearlyData).forEach(function(year) {
                const data = yearlyData[year];
                const stats = data.stats;
                
                // Prüfen ob Daten da sind, sonst leeres Chart vermeiden
                const totalMedals = stats.Gold + stats.Silber + stats.Bronze;
                const noMedal = stats.Ohne;

                const ctx = document.getElementById('chart-' + year);
                if (ctx) {
                    new Chart(ctx, {
                        type: 'doughnut',
                        data: {
                            labels: ['Gold', 'Silber', 'Bronze', 'Ohne Abzeichen'],
                            datasets: [{
                                data: [stats.Gold, stats.Silber, stats.Bronze, noMedal],
                                backgroundColor: [
                                    '#FFD700', // Gold
                                    '#C0C0C0', // Silber
                                    '#cd7f32', // Bronze
                                    '#e9ecef'  // Ohne (Hellgrau)
                                ],
                                borderWidth: 1
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            plugins: {
                                legend: {
                                    position: 'bottom',
                                    labels: { boxWidth: 12, padding: 15 }
                                }
                            },
                            layout: {
                                padding: 10
                            }
                        }
                    });
                }
            });
        });
    </script>
{% endblock %}