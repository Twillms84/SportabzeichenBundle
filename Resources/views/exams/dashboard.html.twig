{% extends '@IServCore/page.html.twig' %}

{% block title %}Sportabzeichen Übersicht{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('pulsrsportabzeichen/css/dashboard.css') }}">
    <style>
        /* Kleiner Hotfix, falls die Icons zicken */
        .btn .icon { margin-right: 4px; }
        /* Damit die Toolbar nicht umbricht */
        .btn-toolbar { display: flex; gap: 5px; }
    </style>
{% endblock %}

{% block content %}
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h1 class="h3 m-0">Sportabzeichen Dashboard</h1>
            <a href="{{ path('sportabzeichen_exams_new') }}" class="btn btn-primary">
                <span class="icon icon-plus"></span> Neue Prüfung anlegen
            </a>
        </div>
    </div>

    {% if yearlyStats is empty %}
        <div class="alert alert-info">
            Noch keine Prüfungen angelegt. Starten Sie mit "Neue Prüfung anlegen".
        </div>
    {% else %}

        {# --- DATEN-BRÜCKE --- #}
        <div id="dashboard-data-store" 
             data-stats="{{ yearlyStats|json_encode|e('html_attr') }}" 
             style="display: none;">
        </div>

        {% for year, data in yearlyStats %}
            <div class="panel panel-default mb-4">
                <div class="panel-heading d-flex justify-content-between align-items-center" style="background-color: #f8f9fa;">
                    <h3 class="panel-title font-weight-bold" style="font-size: 1.25rem;">
                        <span class="icon icon-calendar"></span> Jahrgang {{ year }}
                    </h3>
                    <span class="badge">{{ data.exams|length }} Termine</span>
                </div>
                
                <div class="panel-body">
                    <div class="row">
                        {# --- LINKS: LISTE --- #}
                        <div class="col-md-8">
                            
                            {# Info Kacheln (Gold/Silber/Bronze) hier ausgeblendet für Übersicht, oder einkommentieren wenn gewünscht #}
                            {# Hier direkt die Liste #}
                            
                            <h5 class="text-muted text-uppercase font-weight-bold mb-3">Prüfungstermine</h5>
                            <div class="list-group">
                                {% for exam in data.exams %}
                                    <div class="list-group-item clearfix" style="display: flex; justify-content: space-between; align-items: center;">
                                        
                                        {# Linker Teil: Name #}
                                        <div>
                                            <h4 class="list-group-item-heading mt-0 mb-1">
                                                <a href="{{ path('sportabzeichen_results_index', {id: exam.id}) }}" class="text-primary font-weight-bold">
                                                    {{ exam.exam_name }}
                                                </a>
                                            </h4>
                                            <p class="list-group-item-text text-muted small">
                                                <span class="icon icon-calendar"></span> 
                                                {{ exam.exam_date ? exam.exam_date|date('d.m.Y') : 'Kein Datum' }}
                                            </p>
                                        </div>

                                        {# Rechter Teil: Buttons #}
                                        <div class="btn-toolbar" style="margin-left: auto;">
                                            
                                            {# Ergebnisse #}
                                            <a href="{{ path('sportabzeichen_results_index', {id: exam.id}) }}" class="btn btn-sm btn-primary" title="Ergebnisse">
                                                <span class="icon icon-pencil"></span> Ergebnisse
                                            </a>

                                            {# Statistik #}
                                            <a href="{{ path('sportabzeichen_exams_stats', {id: exam.id}) }}" class="btn btn-sm btn-default" title="Statistik">
                                                <span class="icon icon-chart-bar"></span> Statistik
                                            </a>

                                            {# Ändern #}
                                            <a href="{{ path('sportabzeichen_exams_edit', {id: exam.id}) }}" class="btn btn-sm btn-default" title="Bearbeiten">
                                                <span class="icon icon-cog"></span> Ändern
                                            </a>

                                            {# Löschen - JETZT SEPARAT UND MIT TEXT #}
                                            <button type="button" class="btn btn-sm btn-danger" 
                                                    onclick="if(confirm('Wirklich löschen?')) { document.getElementById('del-{{ exam.id }}').submit(); }">
                                                <span class="icon icon-trash"></span> Löschen
                                            </button>

                                            {# Das versteckte Formular (ganz sicher hier) #}
                                            <form id="del-{{ exam.id }}" action="{{ path('sportabzeichen_exams_delete', {id: exam.id}) }}" method="post" style="display:none;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ exam.id) }}">
                                            </form>

                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        {# --- RECHTS: CHART --- #}
                        <div class="col-md-4 border-left">
                            <h5 class="text-center text-muted">Medaillenspiegel {{ year }}</h5>
                            
                            {# Container mit fester Höhe, damit ChartJS rendert #}
                            <div style="position: relative; height: 250px; width: 100%;">
                                <canvas id="chart-{{ year }}"></canvas>
                            </div>

                            <div class="text-center mt-3 small text-muted">
                                Erfolgsquote: 
                                {% if data.unique_users|length > 0 %}
                                    {{ ((data.stats.Total / data.unique_users|length) * 100)|round(1) }}%
                                {% else %}
                                    0%
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}

    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const store = document.getElementById('dashboard-data-store');
        if (!store) return;

        const allStats = JSON.parse(store.dataset.stats);

        for (const [year, data] of Object.entries(allStats)) {
            const ctx = document.getElementById('chart-' + year);
            if (ctx) {
                // Berechne "Ohne Medaille"
                const noMedal = Math.max(0, Object.keys(data.unique_users).length - data.stats.Total);

                new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Gold', 'Silber', 'Bronze', 'Teilgenommen (ohne)'],
                        datasets: [{
                            data: [
                                data.stats.Gold, 
                                data.stats.Silber, 
                                data.stats.Bronze, 
                                noMedal
                            ],
                            backgroundColor: ['#FFD700', '#C0C0C0', '#CD7F32', '#f0f0f0'],
                            borderWidth: 1
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false, // Wichtig damit es in die Box passt
                        plugins: {
                            legend: { position: 'bottom' }
                        }
                    }
                });
            }
        }
    });
    </script>
{% endblock %}