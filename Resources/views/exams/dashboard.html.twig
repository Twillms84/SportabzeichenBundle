{% extends '@IServCore/page.html.twig' %}

{% block title %}Sportabzeichen Übersicht{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('pulsrsportabzeichen/css/dashboard.css') }}">
{% endblock %}

{% block content %}
    <div class="row mb-4">
        <div class="col-12 d-flex justify-content-between align-items-center">
            <h1 class="h3 m-0">Sportabzeichen Dashboard</h1>
            <a href="{{ path('sportabzeichen_exams_new') }}" class="btn btn-primary">
                <span class="icon icon-plus"></span> Neue Prüfung anlegen
            </a>
        </div>
    </div>

    {% if yearlyStats is empty %}
        <div class="alert alert-info">
            Noch keine Prüfungen angelegt. Starten Sie mit "Neue Prüfung anlegen".
        </div>
    {% else %}

        {# --- DATEN-BRÜCKE: Hier liegen die Daten für das JS --- #}
        <div id="dashboard-data-store" 
             data-stats="{{ yearlyStats|json_encode|e('html_attr') }}" 
             style="display: none;">
        </div>

        {% for year, data in yearlyStats %}
            <div class="panel panel-default mb-4">
                <div class="panel-heading d-flex justify-content-between align-items-center" style="background-color: #f8f9fa;">
                    <h3 class="panel-title font-weight-bold" style="font-size: 1.25rem;">
                        <span class="icon icon-calendar"></span> Jahrgang {{ year }}
                    </h3>
                    <span class="badge">{{ data.exams|length }} Termine</span>
                </div>
                
                <div class="panel-body">
                    <div class="row">
                        {# --- LINKS: KACHELN & LISTE --- #}
                        <div class="col-md-8">
                            
                            {# Info Kacheln #}
                            <div class="row mb-4">
                                <div class="col-sm-6 col-lg-3">
                                    <div class="card shadow-sm p-3 mb-2 bg-white rounded text-center border-gold stat-card">
                                        <div class="h3 m-0 font-weight-bold text-gold">{{ data.stats.Gold }}</div>
                                        <small class="text-muted text-uppercase">Gold</small>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-3">
                                    <div class="card shadow-sm p-3 mb-2 bg-white rounded text-center border-silver stat-card">
                                        <div class="h3 m-0 font-weight-bold text-silver">{{ data.stats.Silber }}</div>
                                        <small class="text-muted text-uppercase">Silber</small>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-3">
                                    <div class="card shadow-sm p-3 mb-2 bg-white rounded text-center border-bronze stat-card">
                                        <div class="h3 m-0 font-weight-bold text-bronze">{{ data.stats.Bronze }}</div>
                                        <small class="text-muted text-uppercase">Bronze</small>
                                    </div>
                                </div>
                                <div class="col-sm-6 col-lg-3">
                                    <div class="card shadow-sm p-3 mb-2 bg-white rounded text-center stat-card" style="border-left: 4px solid #0d6efd;">
                                        <div class="h3 m-0 font-weight-bold text-primary">{{ data.unique_users|length }}</div>
                                        <small class="text-muted text-uppercase">Teilnehmer</small>
                                    </div>
                                </div>
                            </div>
                            
                            <hr>
                            
                            {# Liste der Prüfungen #}
                            <h5 class="text-muted text-uppercase font-weight-bold mb-3" style="font-size: 0.85rem;">Prüfungstermine</h5>
                            <div class="list-group">
                                {% for exam in data.exams %}
                                    <div class="list-group-item d-flex flex-wrap justify-content-between align-items-center">
                                        <div class="mb-2 mb-md-0 mr-3">
                                            <h5 class="list-group-item-heading mb-1 font-weight-bold">
                                                <a href="{{ path('sportabzeichen_results_index', {id: exam.id}) }}" style="color: inherit; text-decoration: none;">
                                                    {{ exam.exam_name }}
                                                </a>
                                            </h5>
                                            <p class="list-group-item-text text-muted mb-0 small">
                                                <span class="icon icon-calendar"></span> {{ exam.exam_date ? exam.exam_date|date('d.m.Y') : 'Kein Datum' }}
                                            </p>
                                        </div>

                                        <div class="btn-toolbar" role="toolbar">
                                            {# Button: Ergebnisse #}
                                            <div class="btn-group mr-2" role="group">
                                                <a href="{{ path('sportabzeichen_results_index', {id: exam.id}) }}" class="btn btn-sm btn-primary" title="Ergebnisse eintragen">
                                                    <span class="icon icon-pencil"></span> Ergebnisse
                                                </a>
                                            </div>

                                            {# Button: Statistik #}
                                            <div class="btn-group mr-2" role="group">
                                                <a href="{{ path('sportabzeichen_exams_stats', {id: exam.id}) }}" class="btn btn-sm btn-default" title="Statistik ansehen">
                                                    <span class="icon icon-chart-bar"></span> Statistik
                                                </a>
                                            </div>

                                            {# Admin Buttons: Ändern & Löschen #}
                                            <div class="btn-group" role="group">
                                                <a href="{{ path('sportabzeichen_exams_edit', {id: exam.id}) }}" class="btn btn-sm btn-default" title="Einstellungen ändern">
                                                    <span class="icon icon-cog"></span> Ändern
                                                </a>
                                                
                                                {# Der Löschen-Button triggert das Formular per JS #}
                                                <button type="button" class="btn btn-sm btn-danger" title="Löschen" 
                                                        onclick="if(confirm('Prüfung wirklich unwiderruflich löschen?')) { document.getElementById('delete-form-{{ exam.id }}').submit(); }">
                                                    <span class="icon icon-trash"></span>
                                                </button>
                                            </div>
                                            
                                            {# Das Formular liegt jetzt AUẞERHALB der btn-group, damit das CSS nicht kaputt geht #}
                                            <form id="delete-form-{{ exam.id }}" action="{{ path('sportabzeichen_exams_delete', {id: exam.id}) }}" method="post" style="display: none;">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ exam.id) }}">
                                            </form>

                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        {# --- RECHTS: CHART --- #}
                        <div class="col-md-4 border-left">
                            <h5 class="text-center text-muted mb-3">Medaillenspiegel {{ year }}</h5>
                            <div class="chart-wrapper">
                                {# Das Canvas Element für Chart.js #}
                                <canvas id="chart-{{ year }}"></canvas>
                            </div>
                            <div class="text-center mt-3 small text-muted">
                                Erfolgsquote: 
                                {% if data.unique_users|length > 0 %}
                                    {{ ((data.stats.Total / data.unique_users|length) * 100)|round(1) }}%
                                {% else %}
                                    0%
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}

    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# Chart.js muss geladen sein #}
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    {# Dein JS Script (Inhalt siehe unten) #}
    <script src="{{ asset('pulsrsportabzeichen/js/dashboard.js') }}"></script>
{% endblock %}